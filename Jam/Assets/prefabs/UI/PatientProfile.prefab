      m_Calls: []
  m_text: "<b>Patient 04</b>\nName: Lavinia Fernsby\r\nAge: 25\r\nOccupation: Accountant\r\nAllergies:
    Moon Mushroom, Fairy Dust\r\n\r\n<b>Short Description</b>\nA positively dauntless,
    upper class individual.\r\nHer prosthetic eyes are awe inspiring.\r\n\r\n<b>Current
    Health Status\r</b>\nPatient complaints\r\n\u2013 Consistent pain all over her
    body that gets worse when her heart pumps rapidly\r\n\u2013 A cough\r\nAny relevant
    pre-existing info or dietary habits\n\u2013\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5182d6596a54d3a419c3e8751b600b9d, type: 2}
